#
# Jellyfin Media Server container.
#
# Key architectural notes:
#   - Network: Uses host networking for local network discovery (DLNA/SSDP),
#     matching the Plex setup. Jellyfin's default web UI port is 8096 (HTTP)
#     and 8920 (HTTPS), both exposed directly on the host interface.
#   - Transcoding: The i5-12400F lacks QuickSync, so the PodmanArgs block
#     explicitly passes the hypervisor render device through for hardware
#     acceleration (VAAPI). Jellyfin uses VAAPI natively on Linux rather
#     than QuickSync — the same /dev/dri device, different codec path.
#   - Image: Uses the official Jellyfin image rather than LinuxServer.io.
#     This means no PUID/PGID env vars — the container runs as an internal
#     jellyfin user by default. File permissions on bind mounts must allow
#     read access for UID 1000 (the default inside the container).
#

[Unit]
Description=Jellyfin Media Server
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/jellyfin/jellyfin:latest
ContainerName=jf

# ---- Environment Variables ----
# Jellyfin's official image does not use PUID/PGID like LinuxServer images.
# TZ sets the timezone for logs and scheduled tasks.
Environment=TZ=America/Halifax

# ---- Volumes ----
# Config (database, metadata, plugins, settings) mapped to a named volume
Volume=jellyfin-config.volume:/config

# Cache (transcoder temp files, image caches) mapped to a named volume
# Keeps transcoding artifacts off the config volume for cleaner backups
Volume=jellyfin-cache.volume:/cache

# Media mapped as read-only with shared SELinux labeling to protect host files
Volume=/home/admin/media:/media:ro,z

# ---- Network ----
# Bypasses bridge networking to sit directly on the host interface.
# Latency on a bridge is more or less negligible. However, discovery protocols (IE: Multicast traffic)
# is more likely to succeed when not required to go through a bridge.
# Jellyfin listens on port 8096 (HTTP) and 8920 (HTTPS) by default
Network=host

# ---- Resource limits & Hardware Acceleration ----
# Passes the GPU render device for VAAPI hardware transcoding
# Note: This is not likely not requried in most cases, as the endpoint device does the transcoding.
PodmanArgs=--device=/dev/dri:/dev/dri --memory 4g

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300

[Install]
WantedBy=default.target
