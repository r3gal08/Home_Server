
[Unit]
Description=Brett and Holly's Chores
After=network-online.target
Wants=network-online.target

[Container]
Image=donetick/donetick:latest
ContainerName=dt

# ---- Environment Variables ----
Environment=UID=0
Environment=GID=0

# ---- Volumes & Networking ----
Volume=dt-data.volume:/data

# Standard Minecraft Java port
PublishPort=2021:2021

# ---- Resource Limits ----
PodmanArgs=--memory 4g

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300

[Install]
WantedBy=default.target
