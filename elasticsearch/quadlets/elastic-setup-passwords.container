#
# Oneshot init container — sets the kibana_system password in Elasticsearch.
#
# This replaces the SECOND half of the docker-compose "setup" service.
# It runs AFTER es01 is healthy (Notify=healthy on es01 ensures this).
#
# The script has its own retry loops as a safety net, but with the
# After=elastic-es01.service dependency and es01's Notify=healthy,
# Elasticsearch should already be accepting connections when this starts.
#

[Unit]
Description=Elasticsearch Password Setup (oneshot)
# es01 uses Notify=healthy, so this won't start until ES is accepting connections
After=elastic-es01.service
Requires=elastic-es01.service

[Container]
# Uses the standard ES image (has curl for the API calls)
Image=docker.elastic.co/elasticsearch/elasticsearch:9.5.5
ContainerName=elastic-setup-passwords

# Passwords for API authentication and the password we're setting
EnvironmentFile=/etc/containers/systemd/users/elastic.env

# Certs volume — needed to verify HTTPS connection to es01
Volume=elastic-certs.volume:/usr/share/elasticsearch/config/certs

# Bind-mount the password setup script (read-only; pre-labeled with container_file_t)
Volume=/etc/containers/systemd/users/elastic-scripts/setup-passwords:/scripts/setup-passwords:ro

# Must be on the same network as es01 to reach it by name
Network=elastic.network

Exec=/bin/bash /scripts/setup-passwords

[Service]
# oneshot = systemd waits for the process to exit before marking it "active"
Type=oneshot

# Keep the service in "active" state after exit so dependents can start
RemainAfterExit=yes

# 10 minutes — mostly waiting for the API call to succeed
TimeoutStartSec=600

[Install]
WantedBy=default.target

