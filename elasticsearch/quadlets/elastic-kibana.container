#
# Kibana dashboard container.
#
#
# Depends on elastic-setup-passwords completing, which transitively
# guarantees that es01 is healthy AND the kibana_system password is set.
#

[Unit]
Description=Kibana 9.5.5 Dashboard
# setup-passwords completing implies es01 is healthy + password is configured
After=elastic-setup-passwords.service
Requires=elastic-setup-passwords.service

[Container]
# Wolfi variant (security, man)
Image=docker.elastic.co/kibana/kibana-wolfi:9.5.5
ContainerName=kibana

# ELASTICSEARCH_PASSWORD (= KIBANA_PASSWORD) is loaded from the env file
EnvironmentFile=/etc/containers/systemd/users/elastic.env

# ---- Volumes ----
# kibana.yml mounted read-write (:z) so entrypoint can append generated encryption keys on first start
Volume=/etc/containers/systemd/users/kibana.yml:/usr/share/kibana/config/kibana.yml:z
Volume=elastic-certs.volume:/usr/share/kibana/config/certs:ro
Volume=elastic-kibanadata.volume:/usr/share/kibana/data
Volume=/etc/containers/systemd/users/elastic-scripts/kibana-entrypoint:/scripts/kibana-entrypoint:ro

# Entrypoint script: generates encryption keys via `kibana-encryption-keys` if missing, then starts Kibana
Exec=/bin/bash /scripts/kibana-entrypoint

# ---- Network ----
Network=elastic.network

# ---- Port mapping ----
PublishPort=5601:5601

# ---- Resource limits ----
PodmanArgs=--memory 1g

# ---- Health check ----
HealthCmd=curl -s -I http://localhost:5601 | grep -q 'HTTP/1.1 302 Found'
HealthInterval=10s
HealthTimeout=10s
HealthRetries=120

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300

[Install]
WantedBy=default.target

