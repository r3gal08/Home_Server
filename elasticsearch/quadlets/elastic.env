# Elastic Stack Secrets & Configuration
# This file is read by Podman (--env-file), NOT by the shell.
# Do NOT quote values — Podman reads them literally.
# Example: ELASTIC_PASSWORD=MyStr0ngP@ss   (no quotes)

# Password for the 'elastic' superuser (at least 6 characters)
ELASTIC_PASSWORD=

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=

# Kibana reads this env var internally — set it to the SAME value as KIBANA_PASSWORD
ELASTICSEARCH_PASSWORD=

