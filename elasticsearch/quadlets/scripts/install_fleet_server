#!/bin/bash

# This is a helper script to install Fleet Server on the host (hypervisor).
# It uses certs generated automatically by setup-certs.sh and exported to the host.
# Typically these commands are generated and given to you within Kibana when creating a fleet server, but still keeping one here for reference.
# This script needs to be ran as root. TODO: Add a check for root user and exit if not root.

FLEET_CERTS_DIR="${1:-/etc/containers/systemd/users/fleet-certs}"

if [ ! -f "${FLEET_CERTS_DIR}/ca.crt" ] || [ ! -f "${FLEET_CERTS_DIR}/fleet-server/fleet-server.crt" ]; then
    echo "ERROR: Certificates not found in ${FLEET_CERTS_DIR}"
    echo "Ensure elastic-setup-certs has run and exported certificates to the host."
    exit 1
fi

TAR_FILE="elastic-agent-9.5.5-linux-x86_64.tar.gz"

if [ ! -f "$TAR_FILE" ]; then
    echo "Downloading $TAR_FILE..."
    curl -L -O "https://artifacts.elastic.co/downloads/beats/elastic-agent/$TAR_FILE"
else
    echo "$TAR_FILE already exists, skipping download."
fi

tar xzvf "$TAR_FILE"
cd elastic-agent-9.5.5-linux-x86_64

# Need to be root...
./elastic-agent install --url=https://192.168.2.56:8220 \
  --fleet-server-es=https://192.168.2.56:9200 \
  --fleet-server-service-token= \
  --fleet-server-policy=fleet-server-policy \
  --certificate-authorities="${FLEET_CERTS_DIR}/ca.crt" \
  --fleet-server-es-ca="${FLEET_CERTS_DIR}/ca.crt" \
  --fleet-server-cert="${FLEET_CERTS_DIR}/fleet-server/fleet-server.crt" \
  --fleet-server-cert-key="${FLEET_CERTS_DIR}/fleet-server/fleet-server.key" \
  --fleet-server-port=8220 \
  --install-servers
