#!/bin/bash

# This is a helper script to install Fleet Server. It uses certs pulled from elastic_cert_gen
# Typically these commands are generated and given to you within Kibana when creating a fleet server, but stll keeping one here for reference  


TAR_FILE="elastic-agent-9.5.5-linux-x86_64.tar.gz"

if [ ! -f "$TAR_FILE" ]; then
    echo "Downloading $TAR_FILE..."
    curl -L -O "https://artifacts.elastic.co/downloads/beats/elastic-agent/$TAR_FILE"
else
    echo "$TAR_FILE already exists, skipping download."
fi

tar xzvf "$TAR_FILE"
cd elastic-agent-9.5.5-linux-x86_64

# Need to be root...
./elastic-agent install --url=https://192.168.2.56:8220 \
  --fleet-server-es=https://192.168.2.56:9200 \
  --fleet-server-service-token= \
  --fleet-server-policy=fleet-server-policy \
  --certificate-authorities=$PWD/fleet-server-certs/fleet-server/fleet-server.crt \
  --fleet-server-es-ca=$PWD/ca.crt \
  --fleet-server-cert=$PWD/fleet-server-certs/fleet-server/fleet-server.crt \
  --fleet-server-cert-key=$PWD/fleet-server-certs/fleet-server/fleet-server.key \
  --fleet-server-port=8220 \
  --install-servers
