#!/bin/bash

### This is a helper script to install Fleet Server. It uses certs pulled from elastic_cert_gen ###

curl -L -O https://artifacts.elastic.co/downloads/beats/elastic-agent/elastic-agent-9.5.5-linux-x86_64.tar.gz
tar xzvf elastic-agent-9.5.5-linux-x86_64.tar.gz

cd elastic-agent-9.5.5-linux-x86_64
sudo ./elastic-agent install --url=https://192.168.2.56:8220 \
  --fleet-server-es=https://192.168.2.56:9200 \
  --fleet-server-service-token=AAEAAWVsYXN0aWMvZmxlZXQtc2VydmVyL3Rva2VuLTE3OTE4NTU0NDg1MDA6cFJ0bndwaEhRaTZObnQ3ZEZNQkM3UQ \
  --fleet-server-policy=fleet-server-policy \
  --fleet-server-cert=/home/admin/containers_stb_qublets/elasticsearch/fleet-server-certs/fleet-server/fleet-server.crt \
  --fleet-server-cert-key=/home/admin/containers_stb_qublets/elasticsearch/fleet-server-certs/fleet-server/fleet-server.key \
  --certificate-authorities=/home/admin/containers_stb_qublets/elasticsearch/fleet-ca/ca/ca.crt \
  --fleet-server-es-ca=/home/admin/containers_stb_qublets/elasticsearch/ca.crt \
  --fleet-server-port=8220 \
  --install-servers
