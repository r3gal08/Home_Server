[Unit]
Description=Minecraft Java Edition Fabric (modded) Server
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/itzg/minecraft-server:latest
ContainerName=mc

# ---- Environment Variables ----
# Mojang requires EULA acceptance to boot
Environment=EULA=TRUE
Environment=UID=0
Environment=GID=0

# ---- Server Settings ----
Environment=VERSION=LATEST
Environment=TYPE=FABRIC
Environment=MODRINTH_PROJECTS=fabric-api
# Restrict the Java heap size to 5GB to prevent out-of-memory crashes
Environment=MEMORY=5G

# ---- Volumes & Networking ----
Volume=mc-data.volume:/data
Volume=/etc/containers/systemd/users/mc-configs/server.properties:/data/server.properties:Z
# Standard Minecraft Java port
PublishPort=25565:25565

# ---- Resource Limits ----
# The Podman hard limit MUST be higher than the Java heap (MEMORY=5G)
# to account for JVM overhead 
# Ex: Thread stacks, garbage collection processing, and native C++ libraries
PodmanArgs=--memory 6g

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300

[Install]
WantedBy=default.target